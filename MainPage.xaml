<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:expense_tracker.ViewModels"
             xmlns:models="clr-namespace:expense_tracker.Models"
             x:Class="expense_tracker.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="Expense Tracker">

    <Grid RowDefinitions="Auto, Auto, *"
          Padding="16"
          RowSpacing="16">

        <!-- 1. Summary Card -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="#CCCCCC"
                Padding="20"
                BackgroundColor="#F8F9FA">
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Total Spent"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center" />
                <Label Text="{Binding TotalExpenses, StringFormat='${0:F2}'}"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#2B2B2B"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <!-- 2. Input Form -->
        <VerticalStackLayout Grid.Row="1" Spacing="10">
            <Entry Placeholder="Expense Title (e.g. Lunch)"
                   Text="{Binding Title}" />

            <Entry Placeholder="Amount (e.g. 12.50)"
                   Text="{Binding Amount}"
                   Keyboard="Numeric" />

            <Picker Title="Select Category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedCategory}" />

            <Button Text="Add Expense"
                    Command="{Binding AddExpenseCommand}"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8" />
        </VerticalStackLayout>

        <!-- 3. Expenses List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Expenses}"
                        SelectionMode="None">
            
            <CollectionView.EmptyView>
                <Label Text="No expenses logged yet."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray"
                       Margin="0,30,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Expense">
                    <!-- SwipeView allows swiping to delete -->
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="Red"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=DeleteExpenseCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="#E0E0E0"
                                Padding="12"
                                Margin="0, 4">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="16" />
                                    <Label Text="{Binding Category}"
                                           FontSize="12"
                                           TextColor="Gray" />
                                    <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}"
                                           FontSize="11"
                                           TextColor="DarkGray" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding Amount, StringFormat='-${0:F2}'}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#D9383A"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>